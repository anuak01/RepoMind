# Copy this file to backend/.env and fill in your key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_MAX_TOKENS=8192

# Where uploaded repositories, the vector index and analysis results are stored
# REPOMIND_DATA_DIR=./data

# "minilm" = sentence-transformers/all-MiniLM-L6-v2 (default, real embeddings)
# "hash"   = offline keyword-hash vectors, ONLY for automated tests / no-internet use
REPOMIND_EMBEDDINGS=minilm

MAX_UPLOAD_MB=100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
